{
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.local/bin/moshi-hook\"; [ -x \"$h\" ] && \"$h\" claude-hook || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.local/bin/moshi-hook\"; [ -x \"$h\" ] && \"$h\" claude-hook || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.local/bin/moshi-hook\"; [ -x \"$h\" ] && \"$h\" claude-hook || true",
            "timeout": 300,
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/bin/dotfiles\" hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.local/bin/moshi-hook\"; [ -x \"$h\" ] && \"$h\" claude-hook || true",
            "async": true
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.local/bin/moshi-hook\"; [ -x \"$h\" ] && \"$h\" claude-hook || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.local/bin/moshi-hook\"; [ -x \"$h\" ] && \"$h\" claude-hook || true",
            "async": true
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.local/bin/moshi-hook\"; [ -x \"$h\" ] && \"$h\" claude-hook || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.local/bin/moshi-hook\"; [ -x \"$h\" ] && \"$h\" claude-hook || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.local/bin/moshi-hook\"; [ -x \"$h\" ] && \"$h\" claude-hook || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$HOME/.local/share/uv/tools/runlayer/bin/runlayer\"; [ -x \"$r\" ] && \"$r\" hook --client claude_code --no-enforcement || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 5
  },
  "footerLinksRegexes": [
    {
      "type": "regex",
      "pattern": "https://github\\.com/(?<owner>[\\w.-]+)/(?<repo>[\\w.-]+)/pull/(?<num>\\d+)",
      "url": "https://github.com/{owner}/{repo}/pull/{num}",
      "label": "PR #{num} ({repo})"
    }
  ],
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "codex@openai-codex": true,
    "context7@context7-marketplace": true,
    "orchestrate@ajilty": true,
    "guards@ajilty": true,
    "playbooks@ajilty": true,
    "edges@ajilty": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/knowledge-work-plugins.git"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ajilty": {
      "source": {
        "source": "github",
        "repo": "ajilty/agentic"
      }
    }
  },
  "outputStyle": "ajilty",
  "effortLevel": "high",
  "fastMode": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
