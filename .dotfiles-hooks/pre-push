#!/usr/bin/env bash
# Push-time guard for the dotfiles repo, which is public on GitHub: the shared
# public-guard, told the repo is public so it needs no GitHub lookup. This
# route works on any git; the global config-based hook that runs public-guard
# for other repos is switched off for this one in ~/.config/git/dotfiles.config,
# so the check runs once. A missing guard script fails the push.
#
# pre-commit never runs on cherry-pick, rebase or `commit-tree`, so this is the
# check that catches what they carry.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$here/../.config/git/public-guard" push --public "$@"
