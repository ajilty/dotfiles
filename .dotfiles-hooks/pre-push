#!/usr/bin/env bash
# Push-time guard for the dotfiles repo: the last check before history is public.
# Activated by core.hooksPath in ~/.config/git/dotfiles.config (via includeIf).
#
# pre-commit never runs on cherry-pick, rebase or `commit-tree`, so a commit
# made that way can carry the wrong identity or a blocklisted string straight
# to GitHub. This re-checks every outgoing commit: author and committer must be
# the expected identity, and no blocklist pattern may appear in its metadata or
# in its added lines. Missing blocklist -> identity check only (bootstrap-safe).
set -euo pipefail

EXPECTED="ajilty <github@ajilty.com>"
BLOCKLIST_FILE="$HOME/.local/config/dotfiles/blocklist"
ZERO=0000000000000000000000000000000000000000

patterns=()
if [[ -f "$BLOCKLIST_FILE" ]]; then
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
        patterns+=("$line")
    done < "$BLOCKLIST_FILE"
fi

matches() {  # matches <text> -> prints each pattern found in it
    local text="$1" p
    for p in ${patterns[@]+"${patterns[@]}"}; do
        if [[ "$p" == re:* ]]; then
            echo "$text" | grep -qiE -- "${p#re:}" && echo "$p"
        else
            echo "$text" | grep -qiF -- "$p" && echo "$p"
        fi
    done
    return 0
}

fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$ZERO" ]] && continue  # branch delete
    if [[ "$remote_sha" == "$ZERO" ]]; then
        range=("$local_sha" --not --remotes)   # new branch: only commits GitHub lacks
    else
        range=("$remote_sha..$local_sha")
    fi

    while read -r c; do
        who_a=$(git log -1 --format='%an <%ae>' "$c")
        who_c=$(git log -1 --format='%cn <%ce>' "$c")
        short=$(git rev-parse --short "$c")
        if [[ "$who_a" != "$EXPECTED" || "$who_c" != "$EXPECTED" ]]; then
            echo "ERROR: $short on $remote_ref: author '$who_a', committer '$who_c'; expected '$EXPECTED'." >&2
            fail=1
        fi
        meta=$(git log -1 --format='%an <%ae> %cn <%ce> %B' "$c")
        added=$(git show --format= --no-color -U0 "$c" | grep -E '^\+' | grep -v '^+++' || true)
        while IFS= read -r p; do
            [[ -z "$p" ]] && continue
            echo "ERROR: $short on $remote_ref matches blocklist pattern: $p" >&2
            fail=1
        done < <(matches "$meta"$'\n'"$added")
    done < <(git rev-list "${range[@]}")
done

if (( fail )); then
    echo "" >&2
    echo "Push blocked: dotfiles push guard. Rewrite the named commits before pushing" >&2
    echo "(committer fix without touching the worktree: see the dotfiles skill)." >&2
    exit 1
fi
