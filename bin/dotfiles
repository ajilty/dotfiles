#!/usr/bin/env bash
# dotfiles: wrapper for the bare-repo dotfiles workflow.
#
# Repo:     ~/.dotfiles (bare)    Worktree: $HOME
# Replaces the old `dotfiles`/`config` shell aliases so it also works in
# non-interactive shells (scripts, agents, cron). Anything that isn't a
# subcommand below passes straight through to git with the right
# --git-dir/--work-tree, so `dotfiles status`, `dotfiles diff`, etc. behave
# exactly as before.
set -euo pipefail

GIT_DIR_PATH="$HOME/.dotfiles"

df_git() {
    git --git-dir="$GIT_DIR_PATH" --work-tree="$HOME" "$@"
}

# Sync-status cache: one line of drift vs the remote, empty when in sync.
# Read cheaply by the new-shell nudge (functions.d/dotfiles-nudge.sh).
SYNC_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/sync-nudge"
SYNC_FETCH_MAX_AGE_MIN=240

# Wording helpers for the drift message: correct plurals and a sentence-style
# list ("a, b and c") so the nudge reads as English rather than git shorthand.
plural() {
    # plural <count> <singular> [<plural>]; defaults to appending an "s".
    if [ "$1" -eq 1 ]; then printf '%s' "$2"; else printf '%s' "${3:-$2s}"; fi
}

join_clauses() {
    local out="" n=$#
    while [ "$#" -gt 0 ]; do
        case "$#" in
            "$n") out="$1" ;;
            1)    out="$out and $1" ;;
            *)    out="$out, $1" ;;
        esac
        shift
    done
    printf '%s' "$out"
}

refresh_sync_status() {
    [ -d "$GIT_DIR_PATH" ] || return 0
    mkdir -p "$(dirname "$SYNC_CACHE")"

    local branch=""
    branch="$(df_git symbolic-ref --short -q HEAD 2>/dev/null || true)"

    # Fetch at most every SYNC_FETCH_MAX_AGE_MIN minutes (FETCH_HEAD mtime
    # is the stamp). The explicit refspec matters: the live repo is a plain
    # `clone --bare` with no upstream config, so a bare `fetch origin`
    # would update FETCH_HEAD only; this populates the origin/<branch> ref
    # the comparison below needs. Counts recompute from local refs on
    # every run, so the nudge clears right after a pull/push/commit.
    local fetch_head="$GIT_DIR_PATH/FETCH_HEAD"
    if [ -n "$branch" ]; then
        if [ ! -e "$fetch_head" ] || [ -n "$(find "$fetch_head" -mmin +"$SYNC_FETCH_MAX_AGE_MIN" 2>/dev/null)" ]; then
            GIT_TERMINAL_PROMPT=0 df_git fetch -q origin \
                "+refs/heads/$branch:refs/remotes/origin/$branch" >/dev/null 2>&1 </dev/null || true
        fi
    fi

    local remote_ref behind=0 ahead=0 dirty
    remote_ref="refs/remotes/origin/$branch"
    if [ -n "$branch" ] && df_git rev-parse --verify -q "$remote_ref" >/dev/null 2>&1; then
        read -r behind ahead <<<"$(df_git rev-list --left-right --count "$remote_ref...HEAD" 2>/dev/null || echo '0 0')"
    fi
    # -uno: skip untracked enumeration; the inverse-allowlist makes it huge.
    dirty="$(df_git status --porcelain -uno 2>/dev/null | wc -l | tr -d ' ')"

    # Message is plain English, one line: what is out of step, then the
    # command to fix it. Counts read as sentence clauses ("2 commits to
    # pull"), not git's ahead/behind shorthand.
    local -a parts=()
    [ "$behind" -gt 0 ] && parts+=("$behind $(plural "$behind" commit) to pull")
    if [ "$ahead" -gt 0 ]; then
        # After a "to pull" clause the noun is already established.
        if [ "$behind" -gt 0 ]; then
            parts+=("$ahead to push")
        else
            parts+=("$ahead $(plural "$ahead" commit) to push")
        fi
    fi
    [ "$dirty" -gt 0 ] && parts+=("$dirty uncommitted $(plural "$dirty" change)")

    local tmp="${SYNC_CACHE}.tmp.$$"
    if [ "${#parts[@]}" -eq 0 ]; then
        : > "$tmp"
    else
        local action
        if [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then
            action='Run "dotfiles pull", then "dotfiles push".'
        elif [ "$behind" -gt 0 ]; then
            action='Run "dotfiles pull" to catch up.'
        elif [ "$ahead" -gt 0 ]; then
            action="Run \"dotfiles push\" to publish $(plural "$ahead" it them)."
        else
            action="Run \"dotfiles status\" to see $(plural "$dirty" it them)."
        fi
        printf 'Your dotfiles have %s. %s\n' "$(join_clauses "${parts[@]}")" "$action" > "$tmp"
    fi
    mv "$tmp" "$SYNC_CACHE"
}

# Detached refresh after commands that change sync state; never blocks or
# fails the foreground command.
refresh_sync_status_bg() {
    ( refresh_sync_status >/dev/null 2>&1 </dev/null & )
}

# --- content blocklist -----------------------------------------------
# The pre-commit hook scans staged diffs against ~/.local/config/dotfiles/
# blocklist (names, emails, host paths) so private strings never reach the
# public remote. These two verbs keep that list fetched and audit history
# the hook never re-checks. Previously the shell functions
# `dotfiles-blocklist-sync` / `-scan`; folded in so `dotfiles help` lists
# the whole typed surface.
BLOCKLIST_DIR="$HOME/.local/config/dotfiles"
BLOCKLIST_FILE="$BLOCKLIST_DIR/blocklist"

blocklist_sync() {
    local gist_id_file="$BLOCKLIST_DIR/gist-id"
    local out_file="$BLOCKLIST_FILE"
    local tmp_file="${out_file}.tmp.$$"

    if [ ! -f "$gist_id_file" ]; then
        echo "dotfiles blocklist sync: gist id file missing." >&2
        echo "  Create $gist_id_file containing just the private gist ID," >&2
        echo "  then re-run. The gist must contain a file named dotfiles-blocklist.txt." >&2
        return 1
    fi

    local gist_id
    gist_id=$(tr -d '[:space:]' < "$gist_id_file")
    if [ -z "$gist_id" ]; then
        echo "dotfiles blocklist sync: $gist_id_file is empty." >&2
        return 1
    fi

    if ! command -v gh >/dev/null 2>&1; then
        echo "dotfiles blocklist sync: gh CLI not installed." >&2
        return 1
    fi

    if ! gh auth status --hostname github.com >/dev/null 2>&1; then
        echo "dotfiles blocklist sync: gh not authenticated. Run: gh auth login --hostname github.com" >&2
        return 1
    fi

    mkdir -p "$BLOCKLIST_DIR"

    if ! gh api "gists/$gist_id" --jq '.files["dotfiles-blocklist.txt"].content' > "$tmp_file" 2>/dev/null; then
        rm -f "$tmp_file"
        echo "dotfiles blocklist sync: gh api fetch failed for gist $gist_id." >&2
        echo "  Check the gist ID and that it contains a file named dotfiles-blocklist.txt." >&2
        return 1
    fi

    if [ ! -s "$tmp_file" ]; then
        rm -f "$tmp_file"
        echo "dotfiles blocklist sync: fetched blocklist is empty. Refusing to overwrite." >&2
        return 1
    fi

    mv "$tmp_file" "$out_file"

    local pattern_count
    pattern_count=$(grep -cv -E '^\s*(#|$)' "$out_file" || true)
    echo "blocklist synced ($pattern_count patterns) -> $out_file"

    blocklist_scan
}

blocklist_scan() {
    # Optional arg: git dir to scan (default: the live dotfiles repo).
    local git_dir="${1:-$GIT_DIR_PATH}"

    if [ ! -f "$BLOCKLIST_FILE" ]; then
        echo "dotfiles blocklist scan: no blocklist at $BLOCKLIST_FILE. Run 'dotfiles blocklist sync' first." >&2
        return 1
    fi

    local patterns_tmp="${TMPDIR:-/tmp}/blocklist-scan.$$"
    local fixed_tmp="${patterns_tmp}.fixed"
    local regex_tmp="${patterns_tmp}.regex"
    grep -v -E '^[[:space:]]*(#|$)' "$BLOCKLIST_FILE" > "$patterns_tmp" || true
    if [ ! -s "$patterns_tmp" ]; then
        rm -f "$patterns_tmp"
        echo "dotfiles blocklist scan: blocklist has no patterns; nothing to scan."
        return 0
    fi
    grep -v '^re:' "$patterns_tmp" > "$fixed_tmp" || true
    sed -n 's/^re://p' "$patterns_tmp" > "$regex_tmp" || true

    local -a revs
    revs=($(git --git-dir="$git_dir" rev-list --all))

    # Match semantics mirror the pre-commit hook (case-insensitive; fixed
    # strings by default, `re:` entries as extended regexes), but binaries
    # are scanned too: .pyc and friends embed paths. git grep exits 1 on a
    # clean scan, which is the good case here, hence the `|| true`.
    local hits=""
    if [ -s "$fixed_tmp" ]; then
        hits=$(git --git-dir="$git_dir" grep -l -i -F -f "$fixed_tmp" "${revs[@]}" 2>/dev/null || true)
    fi
    if [ -s "$regex_tmp" ]; then
        hits=$(printf '%s\n%s' "$hits" \
            "$(git --git-dir="$git_dir" grep -l -i -E -f "$regex_tmp" "${revs[@]}" 2>/dev/null || true)" \
            | grep -v '^$' | sort -u || true)
    fi

    if [ -z "$hits" ]; then
        rm -f "$patterns_tmp" "$fixed_tmp" "$regex_tmp"
        echo "blocklist history scan clean (${#revs[@]} $(plural "${#revs[@]}" commit))"
        return 0
    fi

    local n_commits
    n_commits=$(echo "$hits" | cut -d: -f1 | sort -u | wc -l | tr -d ' ')
    echo "ERROR: blocklist patterns found in committed history ($n_commits of ${#revs[@]} $(plural "${#revs[@]}" commit)):" >&2
    echo "  files:" >&2
    echo "$hits" | sed 's/^[^:]*://' | sort -u | sed 's/^/    /' >&2
    echo "  patterns:" >&2
    local pattern
    while IFS= read -r pattern; do
        if [ "${pattern#re:}" != "$pattern" ]; then
            if git --git-dir="$git_dir" grep -q -i -E -e "${pattern#re:}" "${revs[@]}" 2>/dev/null; then
                echo "    - $pattern" >&2
            fi
        elif git --git-dir="$git_dir" grep -q -i -F -e "$pattern" "${revs[@]}" 2>/dev/null; then
            echo "    - $pattern" >&2
        fi
    done < "$patterns_tmp"
    rm -f "$patterns_tmp" "$fixed_tmp" "$regex_tmp"
    echo "  History already public? Scrub with git-filter-repo + force push (see dotfiles skill)." >&2
    return 1
}

print_help() {
    cat <<'EOF'
dotfiles - opinionated bare-repo management of your user config
           (repo ~/.dotfiles, worktree $HOME)

USAGE
  dotfiles <subcommand|git-command> [args]
  Unrecognized subcommands pass through to git with the correct
  --git-dir/--work-tree. Never use plain `git` against $HOME.

SUBCOMMANDS
  help              This screen.
  tracked           List every tracked file (ls-tree of master).
  track <path>...   Start tracking NEW file(s). Required for new files:
                    .gitignore is an inverse allowlist (`*` then `!` rules),
                    so new paths look ignored until force-added. Wraps
                    `add -f`.
  pull              Pull (rebase + autostash) behind a conflict preflight:
                    fetches, simulates the rebase commit by commit and the
                    autostash reapply on top of its result, and stops before
                    anything moves. Clean pulls are silent and unchanged.
                    A predicted conflict names the commit and paths, prompts
                    at a terminal, and refuses without one (agents, cron),
                    exiting nonzero. Probes are read-only: merge-tree
                    resolves in the object database, stash create never
                    touches the worktree or stash list.
  preflight [<head> [<upstream>]]
                    The same prediction without pulling; exits 1 on a
                    predicted conflict. Pass revisions to replay a past case.
  update            `pull` (same preflight), then `zinit update --all`.
  sync-status       Recompute drift vs the remote (commits to pull/push,
                    uncommitted changes) and print it as one plain-English
                    line, or confirm you are up to date. Backs the new-shell
                    nudge: results cache at ~/.cache/dotfiles/sync-nudge,
                    interactive shells print the cache at the first prompt
                    and refresh it in a background job. Fetches origin at
                    most every 4h; local counts recompute every run.
  blocklist <verb>  Private-string guard for this public repo. The
                    pre-commit hook scans staged diffs against
                    ~/.local/config/dotfiles/blocklist.
                    sync  Fetch that list from the private gist, then scan.
                    scan  Grep the FULL history (all refs) against it: the
                          hook only ever sees staged diffs, so a pattern
                          added after a string was committed is otherwise
                          never re-checked.
  hook              Agent-harness guard: reads a PreToolUse JSON payload on
                    stdin and emits a once-per-session reminder when a tool
                    call touches dotfiles-managed config, edits the shared
                    agent-harness wiring (~/.agents, ~/.claude, ~/.codex,
                    ~/.config/opencode; run `dotfiles doctor` after), runs
                    brew install/uninstall, or handles credentials outside
                    with-secrets (MCP registration, op run, token
                    literals). Informational, never blocks.
                    Registered in ~/.claude/settings.json (Claude Code);
                    portable to any harness that pipes the same JSON.
  doctor            Verify the shared agent-harness wiring: that Claude
                    Code, Codex, and opencode all still resolve
                    ~/.agents/preferences.md and ~/.agents/style.md, and
                    that no vendor installer has re-pinned a hook command
                    to an install-time path. Exits nonzero on drift.
                    `doctor --hooks <file>...` checks hook portability in
                    the named files only; the pre-commit guard uses it to
                    vet staged content without reading $HOME.

STAGING RULES
  Tracked file changed   -> dotfiles add -u <path>   (avoids the bogus
                            "paths are ignored" warning; the file IS tracked)
  New file               -> dotfiles track <path>
  Untrack + re-ignore    -> dotfiles rm -r --cached <path>, then add a
                            re-ignore rule to ~/.gitignore (rules alone
                            never untrack).
  Never add a one-off `!` allowlist rule to .gitignore for a single file;
  `track` (add -f) is the convention.
  Pathspecs resolve relative to the caller's cwd, not $HOME: run from
  $HOME or pass absolute paths, or `track`/`add` fail with
  "pathspec did not match any files".

COMMITTING
  Identity is pinned to `ajilty <github@ajilty.com>` by a pre-commit hook.
  Never --no-verify, --author=, or GIT_AUTHOR_* overrides. If the hook
  trips, the includeIf isn't matching: diagnose with
  `dotfiles config --show-origin user.email`.
  Multi-line messages: write to a file, `dotfiles commit -F <file>`.
  LLM-assisted commits end with a Co-Authored-By: trailer.
  Remote is public: never push without the owner's confirmation.

PULL / CONFLICT QUICKSTART
  `dotfiles pull` = pull --rebase --autostash, gated by the preflight above,
  so a predicted collision stops before it strands anything. If you pull past
  the prompt: while any path is UU/DU/UD, ALL commits are refused, even
  unrelated ones.
    1. dotfiles status; if .dotfiles/rebase-merge/ exists it's a real
       replay conflict, otherwise an autostash-pop conflict.
    2. Resolve each path (add -f modify-modify; rm -f to accept an
       upstream deletion, but check content moved before assuming loss).
       If the stopped commit is your own work already squash-merged
       upstream (the preflight says so), skip it instead:
       dotfiles -c core.editor=true rebase --skip; git drops the rest.
    3. dotfiles -c core.editor=true rebase --continue
  Deep recovery (update-index gotcha, stray MERGE_MSG, blocklist
  bootstrap): load the dotfiles agent skill.

RELATED TOOLING
  Packages: `brew` is wrapped; installs are recorded per-category in
            ~/.config/homebrew/Brewfile.* via brew-sync
            (`brew-sync save <category> <pkg>`, `brew-sync help`).
  Skills:   machine-specific skills live tracked in ~/.agents/skills/<name>/; edit in place, add -u, commit.
  Secrets:  never inline; `with-secrets <preset> -- <cmd>`.
  Shell-wide git env: `dotfiles-shell` exports GIT_DIR/GIT_WORK_TREE.
EOF
}

# Agent-harness guard (the `hook` subcommand). Reads a PreToolUse JSON
# payload on stdin; reminds the agent, once per session per category, when
# it touches dotfiles-managed config (Edit/Write), changes packages (Bash +
# brew), or handles credentials outside with-secrets (Bash). Informational
# only: always exits 0, defers the permission
# decision, never blocks. Standalone-process semantics, so it behaves the
# same whether the harness's shell is bash or zsh.
run_hook() {
    command -v jq >/dev/null 2>&1 || exit 0
    local input tool_name session_id
    input="$(cat)"
    tool_name="$(jq -r '.tool_name // empty' <<<"$input")"
    session_id="$(jq -r '.session_id // "nosession"' <<<"$input")"

    remind() { # $1 = dedup category, $2 = message
        local marker="${TMPDIR:-/tmp}/dotfiles-guard-${session_id}-${1}"
        [ -e "$marker" ] && exit 0
        : > "$marker"
        jq -n --arg ctx "$2" \
            '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "defer", additionalContext: $ctx}}'
        exit 0
    }

    local config_msg brew_msg harness_msg
    config_msg="$(cat <<'EOF'
Heads-up: this path is part of this machine's dotfiles-managed user config (bare repo ~/.dotfiles, worktree $HOME; some areas like ~/.local/config are intentionally local-only). Run `dotfiles help` for the workflow before changing config. Stage tracked changes with `dotfiles add -u <path>`, start tracking new config with `dotfiles track <path>`, and never use plain `git` against $HOME. Recovery and conventions: load the dotfiles skill. (This reminder fires once per session.)
EOF
)"
    brew_msg="$(cat <<'EOF'
Heads-up: packages on this machine are dotfiles-managed. After brew changes, record them: `brew-sync save <category> <pkg>` (categories = ~/.config/homebrew/Brewfile.*) or `brew-sync ignore <pkg>` for one-offs, then review with `dotfiles diff ~/.config/homebrew/`. See `brew-sync help`. (This reminder fires once per session.)
EOF
)"
    harness_msg="$(cat <<'EOF'
Heads-up: this path is part of the shared agent-harness wiring. Working agreements live once in ~/.agents/preferences.md and register/presentation lives once in ~/.agents/style.md; Claude Code, Codex, and opencode all read both (symlinks at ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md, a Codex SessionStart hook, and opencode's instructions list). A rule that changes how output READS belongs in style.md; a rule that changes how work is DONE, verified, or decided belongs in preferences.md. Never fork a harness-specific copy. After changing any wiring, run `dotfiles doctor` to confirm all three harnesses still resolve. (This reminder fires once per session.)
EOF
)"
    secrets_msg="$(cat <<'EOF'
Heads-up: credentials on this machine flow through `with-secrets <preset> -- <cmd>` (1Password op run; presets resolve from ~/.local/config/shell/env.d/ work, then ~/.config/shell/env.d/ personal). Never hardcode secrets, tokens, or `op run --env-file` invocations in commands or configs; MCP server entries use "command": "with-secrets". To add a credential: extend a preset file with export VAR="op://vault/item/field". Full contract in ~/AGENTS.md. (This reminder fires once per session.)
EOF
)"

    case "$tool_name" in
        Edit|Write|MultiEdit)
            local file_path rel managed
            file_path="$(jq -r '.tool_input.file_path // empty' <<<"$input")"
            [ -n "$file_path" ] || exit 0
            case "$file_path" in
                "$HOME"/*) rel="${file_path#"$HOME"/}" ;;
                *) exit 0 ;;
            esac
            # Noise exclusions: agent memory, runtime/cache state, code
            # checkouts, and the bare repo itself.
            case "$rel" in
                .claude/projects/*|.local/share/*|.local/state/*|.cache/*|.dotfiles/*|gits/*) exit 0 ;;
            esac
            managed=0
            case "$rel" in
                .config/*|.local/config/*|bin/*|.agents/*|skills/*|.ssh/*|.dotfiles-hooks/*|.claude/*) managed=1 ;;
                .*) [ "$rel" = "${rel%/*}" ] && managed=1 ;;   # depth-1 dotfile in $HOME
            esac
            if [ "$managed" -eq 0 ]; then
                df_git ls-files --error-unmatch -- "$file_path" >/dev/null 2>&1 && managed=1
            fi
            # Shared agent-harness wiring: read by all three harnesses, so an
            # edit here needs the layer distinction and a wiring re-check.
            # Directory-scoped on purpose: enumerating files goes stale the
            # moment a harness grows a new instruction path.
            case "$rel" in
                .claude/plugins/*|.agents/skills/*) : ;;
                .agents/*|.claude/*|.codex/*|.config/opencode/*)
                    remind harness "$harness_msg" ;;
            esac
            [ "$managed" -eq 1 ] && remind config "$config_msg"
            ;;
        Bash)
            local cmd
            cmd="$(jq -r '.tool_input.command // empty' <<<"$input")"
            # Command position only (line start or after ;|&|( ): avoids
            # firing on `brew install` appearing as prose in echo/grep args.
            if grep -Eq '(^|[;&|(])[[:space:]]*brew[[:space:]]+(install|reinstall|uninstall|remove|rm|tap|untap)([[:space:]]|$)' <<<"$cmd"; then
                remind brew "$brew_msg"
            fi
            # Credential-shaped commands: MCP server registration, direct
            # `op run`, op:// refs, or well-known token literals. A command
            # already routed through with-secrets is doing the right thing.
            if ! grep -q 'with-secrets' <<<"$cmd" && grep -Eq \
                'claude[[:space:]]+mcp[[:space:]]+add|(^|[[:space:];&|(])op[[:space:]]+run([[:space:]]|$)|op://|(sk|rk)-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}' \
                <<<"$cmd"; then
                remind secrets "$secrets_msg"
            fi
            ;;
    esac
    exit 0
}

# Warn-only guard for `dotfiles add`: catches the two inverse-allowlist
# traps (new files need track/-f, tracked files want -u) before git's own
# confusing "paths are ignored" behavior does. Never blocks; git still
# enforces its own rules on the passthrough.
guard_add() {
    local have_force=0 have_update=0 arg
    for arg in "$@"; do
        case "$arg" in
            -f|--force) have_force=1 ;;
            -u|--update) have_update=1 ;;
        esac
    done
    for arg in "$@"; do
        [ "${arg#-}" != "$arg" ] && continue   # skip flags
        [ -e "$arg" ] || continue
        if df_git ls-files --error-unmatch -- "$arg" >/dev/null 2>&1; then
            if [ "$have_update" -eq 0 ] && [ "$have_force" -eq 0 ]; then
                echo "hint: '$arg' is already tracked; prefer 'dotfiles add -u $arg' (the \"paths are ignored\" warning is the inverse-allowlist, not an error)" >&2
            fi
        elif df_git check-ignore -q -- "$arg" 2>/dev/null && [ "$have_force" -eq 0 ]; then
            echo "hint: '$arg' is new and hidden by the inverse-allowlist; use 'dotfiles track $arg' to start tracking it" >&2
        fi
    done
}

# Conflict preflight for `pull`. `pull --rebase --autostash` has two
# independent ways to strand the worktree: replaying local commits onto the
# fetched tip, and reapplying the autostashed dirty worktree afterwards. The
# first sign of either is normally a half-finished pull that blocks every
# commit in the repo, including unrelated ones, with the damage already done.
#
# Both are predictable before anything moves, and both are simulated the way
# git will actually perform them. `merge-tree --write-tree --merge-base`
# computes one three-way merge entirely in the object database, so the replay
# is walked commit by commit onto a rolling probe tip (dangling commit objects
# only; gc reclaims them). `stash create` records the dirty worktree as a
# commit object without touching the worktree or the stash list, and is then
# merged onto the simulated final tip exactly as the autostash pop would be.
#
# Walking the replay matters: a single end-state merge misses collisions in
# intermediate commits. The common case is your own PR squash-merged upstream:
# the final trees agree, but the first of the original commits adds an earlier
# version of a file the squash already holds, and the rebase stops on add/add.

# Results of the last prediction. Globals because the probes run in the
# current shell (a $(...) capture would lose them).
REPLAY_CONFLICTS=""   # CONFLICT lines, prefixed by the commit that fails
DIRTY_CONFLICTS=""    # CONFLICT lines for the autostash reapply
PROBE_TIP=""          # simulated result of the replay (or where it stopped)
SQUASH_HINT=""        # set when the failing commit's files already match upstream

# Simulates `rebase` of $2's local commits onto $1, one commit at a time.
# Mirrors git: commits whose patch already exists upstream are not replayed
# (--cherry-pick), and commits that become empty are dropped. Stops at the
# first commit that fails to replay and records git's own CONFLICT lines,
# which name both the path and the kind of collision (content, modify/delete,
# distinct types).
replay_conflicts() { # $1 = upstream, $2 = local head
    local c out rc tree label
    REPLAY_CONFLICTS="" SQUASH_HINT=""
    PROBE_TIP="$(df_git rev-parse --verify "$1^{commit}")"
    for c in $(df_git rev-list --reverse --no-merges --cherry-pick --right-only "$1...$2"); do
        rc=0
        out="$(df_git merge-tree --write-tree --name-only --merge-base="$c^" "$PROBE_TIP" "$c" 2>/dev/null)" || rc=$?
        case "$rc" in
            0)  tree="${out%%$'\n'*}"
                [ "$tree" = "$(df_git rev-parse "$PROBE_TIP^{tree}")" ] && continue
                PROBE_TIP="$(df_git commit-tree "$tree" -p "$PROBE_TIP" -m "dotfiles preflight probe" 2>/dev/null)" || return 0
                ;;
            1)  label="$(df_git log -1 --format='%h %s' "$c")"
                REPLAY_CONFLICTS="$label"$'\n'"$(printf '%s\n' "$out" | { grep '^CONFLICT ' || true; } | sed 's/^/  /')"
                # Same content on both sides at the end (your PR, squash-merged):
                # the replay is redundant and `rebase --skip` is the fix.
                # shellcheck disable=SC2046
                if df_git diff --quiet "$1" "$2" -- $(df_git diff-tree --no-commit-id --name-only -r "$c") 2>/dev/null; then
                    SQUASH_HINT=1
                fi
                return 0
                ;;
            *)  return 0 ;;   # probe error: nothing to predict, let git decide
        esac
    done
}

# Predicts replaying $2 onto $1, then reapplying the dirty worktree on top of
# the result (only when $2 is HEAD: the stash snapshot is relative to HEAD).
# Silent and 0 when clean; prints the report to stderr and returns 1 when
# something would conflict.
predict_pull() { # $1 = upstream, $2 = local head
    local snap
    replay_conflicts "$1" "$2"

    DIRTY_CONFLICTS=""
    if [ "$(df_git rev-parse --verify "$2^{commit}")" = "$(df_git rev-parse HEAD)" ]; then
        snap="$(df_git stash create 2>/dev/null || true)"
        if [ -n "$snap" ]; then
            DIRTY_CONFLICTS="$({ df_git merge-tree --write-tree --name-only --merge-base=HEAD "$PROBE_TIP" "$snap" 2>/dev/null || true; } \
                | { grep '^CONFLICT ' || true; })"
        fi
    fi

    [ -z "$REPLAY_CONFLICTS" ] && [ -z "$DIRTY_CONFLICTS" ] && return 0

    {
        echo "dotfiles: this pull would conflict. Nothing has been changed yet."
        echo
        if [ -n "$REPLAY_CONFLICTS" ]; then
            echo "  replaying your commits onto $1 stops at:"
            printf '%s\n' "$REPLAY_CONFLICTS" | sed 's/^/    /'
            if [ -n "$SQUASH_HINT" ]; then
                echo
                echo "  The files this commit touches already match upstream at your tip"
                echo "  (typically your own PR, squash-merged). Pull anyway and, at the"
                echo "  stop, run: dotfiles -c core.editor=true rebase --skip"
                echo "  git then drops the rest as \"patch contents already upstream\"."
            fi
        fi
        if [ -n "$DIRTY_CONFLICTS" ]; then
            [ -n "$REPLAY_CONFLICTS" ] && echo
            echo "  reapplying your uncommitted changes:"
            printf '%s\n' "$DIRTY_CONFLICTS" | sed 's/^/    /'
        fi
        echo
    } >&2
    return 1
}

# Fetches, predicts, and either returns (safe to pull) or exits nonzero.
# A clean prediction pulls exactly as before, silently. A predicted conflict
# prompts when a terminal is attached and refuses otherwise: agents and cron
# have no way to answer, and an unattended strand costs far more than a re-run.
preflight_pull() {
    local upstream reply

    # Guards for the cases with nothing to predict: no configured upstream,
    # a git older than 2.40 (no `merge-tree --write-tree --merge-base`), or
    # an unreachable remote. Fall through and let git behave exactly as it
    # does today.
    upstream="$(df_git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    [ -n "$upstream" ] || return 0
    df_git merge-tree --write-tree --merge-base=HEAD HEAD HEAD >/dev/null 2>&1 || return 0
    df_git fetch --quiet 2>/dev/null || return 0

    predict_pull "$upstream" HEAD && return 0

    if [ -t 0 ]; then
        printf 'Pull anyway? [y/N] ' >&2
        read -r reply || reply=""
        reply="${reply%$'\r'}"   # ptys and pasted input carry a trailing CR
        case "$reply" in
            [yY]|[yY][eE][sS]) return 0 ;;
        esac
        echo "aborted; nothing pulled" >&2
        exit 1
    fi

    echo "refusing: no terminal to confirm on. Re-run where you can answer," >&2
    echo "or resolve the collision first (commit, stash, or drop one side)." >&2
    exit 1
}

# --- doctor: agent-harness wiring -----------------------------------------
# Canonical sources, read by every harness:
#   ~/.agents/preferences.md  working agreements (how work is done)
#   ~/.agents/style.md        register (how output reads)

doctor_link() { # path, expected target
    local got
    got=$(readlink -f "$1" 2>/dev/null)
    if [ -n "$got" ] && [ "$got" = "$(readlink -f "$2")" ]; then
        printf '  ok      %s\n' "${1/#$HOME/\~}"
    else
        printf '  BROKEN  %s -> %s\n' "${1/#$HOME/\~}" "${got:-missing}"
        fail=1
    fi
}

# Vendor installers (moshi-hook, herdr) regenerate our harness configs and
# bake in the path the tool lived at that release. Those break on a new
# machine and go stale on every upgrade. Hook commands must resolve at run
# time: `command -v <bin>` for third-party tools, "$HOME/..." for our own
# scripts. These rules live here only; the pre-commit guard calls --hooks.
doctor_hooks() {
    local f label cmds pinned
    for f in "$@"; do
        [ -f "$f" ] || continue
        label="${f/#$HOME/\~}"
        cmds=$(jq -r '[.hooks[]?[]?.hooks[]?.command // empty] | .[]' "$f" 2>/dev/null)
        pinned=$( { # an absolute path into anyone's home, or a versioned Cellar dir
                    grep -E '/Users/|/home/|/var/home/|/Cellar/' <<<"$cmds"
                    # ...and moshi-hook by path at all: even "$HOME/.local/bin"
                    # clears the rule above and still breaks when the tool moves.
                    grep -F 'moshi-hook' <<<"$cmds" | grep -vF 'command -v'
                  } | sort -u )
        if [ -z "$pinned" ]; then
            printf '  ok      %s hooks resolve at run time\n' "$label"
        else
            printf '  BROKEN  %s pins tool paths (an installer rewrote it):\n' "$label"
            cut -c1-96 <<<"$pinned" | sed 's/^/            /'
            fail=1
        fi
    done
}

run_doctor() {
    set +e   # a failed check reports drift; it must not abort the run
    local prefs="$HOME/.agents/preferences.md"
    local style="$HOME/.agents/style.md"
    local want sel f
    fail=0

    # Ahead of the canonical-file check, so a fresh machine can still commit.
    if [ "${1:-}" = "--hooks" ]; then
        shift
        echo "hook portability:"
        doctor_hooks "$@"
        exit $fail
    fi

    for f in "$prefs" "$style"; do
        [ -f "$f" ] || { printf 'BROKEN  canonical file missing: %s\n' "$f"; exit 1; }
    done

    echo "preferences:"
    doctor_link "$HOME/.claude/CLAUDE.md" "$prefs"
    doctor_link "$HOME/.codex/AGENTS.md" "$prefs"

    echo "style:"
    doctor_link "$HOME/.claude/output-styles/ajilty.md" "$style"

    echo "opencode:"
    for want in "~/.agents/preferences.md" "~/.agents/style.md"; do
        if jq -e --arg w "$want" '[.instructions[]?] | index($w)' \
             "$HOME/.config/opencode/opencode.json" >/dev/null 2>&1; then
            printf '  ok      instructions[] lists %s\n' "$want"
        else
            printf '  BROKEN  instructions[] missing %s\n' "$want"
            fail=1
        fi
    done
    if [ -e "$HOME/.config/opencode/AGENTS.md" ]; then
        echo "  BROKEN  ~/.config/opencode/AGENTS.md shadows the canonical file"
        fail=1
    fi

    echo "codex:"
    if jq -e '[.hooks.SessionStart[]?.hooks[]?.command] | map(select(test("style\\.md"))) | length > 0' \
         "$HOME/.codex/hooks.json" >/dev/null 2>&1; then
        echo "  ok      SessionStart hook emits style.md"
    else
        echo "  BROKEN  no SessionStart hook emits style.md"
        fail=1
    fi

    echo "claude:"
    sel=$(jq -r '.outputStyle // "unset"' "$HOME/.claude/settings.json" 2>/dev/null)
    if [ "$sel" = "ajilty" ]; then
        echo "  ok      settings.json outputStyle=$sel"
    else
        echo "  BROKEN  settings.json outputStyle=$sel"
        fail=1
    fi

    echo "hook portability:"
    doctor_hooks "$HOME/.claude/settings.json" "$HOME/.codex/hooks.json"

    [ $fail -eq 0 ] && echo "all harness wiring intact"
    exit $fail
}

case "${1:-help}" in
    help|-h|--help)
        print_help
        ;;
    tracked)
        df_git ls-tree -r --full-tree master --name-only
        ;;
    track)
        shift
        if [ "$#" -eq 0 ]; then
            echo "usage: dotfiles track <path>..." >&2
            exit 1
        fi
        df_git add -f -- "$@"
        refresh_sync_status_bg
        echo "tracked and staged: $*"
        echo "next: dotfiles commit (multi-line: -F <file>)"
        ;;
    preflight)
        shift
        upstream="${2:-$(df_git rev-parse --abbrev-ref --symbolic-full-name '@{u}')}"
        df_git fetch --quiet 2>/dev/null || true
        predict_pull "$upstream" "${1:-HEAD}" || exit 1
        echo "clean: replaying ${1:-HEAD} onto $upstream and reapplying the worktree would not conflict"
        ;;
    pull)
        shift
        preflight_pull
        df_git pull "$@"
        refresh_sync_status_bg
        ;;
    sync-status)
        refresh_sync_status
        if [ -s "$SYNC_CACHE" ]; then
            cat "$SYNC_CACHE"
        else
            echo "Your dotfiles are up to date with the remote."
        fi
        ;;
    update)
        preflight_pull
        df_git pull
        refresh_sync_status_bg
        if command -v zsh >/dev/null 2>&1; then
            zsh -ic 'zinit update --all' || echo "zinit update failed; run 'zinit update --all' in an interactive shell" >&2
        else
            echo "zsh not found; skipped 'zinit update --all'" >&2
        fi
        ;;
    add)
        shift
        guard_add "$@"
        df_git add "$@"
        refresh_sync_status_bg
        ;;
    blocklist)
        shift
        case "${1:-help}" in
            sync)
                blocklist_sync
                ;;
            scan)
                shift
                blocklist_scan "$@"
                ;;
            help|-h|--help)
                cat <<'EOF'
usage: dotfiles blocklist <verb>

  sync            Fetch the private blocklist gist into
                  ~/.local/config/dotfiles/blocklist, then scan history.
  scan [<dir>]    Grep the full committed history against the blocklist.
EOF
                ;;
            *)
                echo "dotfiles blocklist: unknown verb '$1' (try: sync, scan)" >&2
                exit 1
                ;;
        esac
        ;;
    hook)
        run_hook
        ;;
    doctor)
        shift
        run_doctor "$@"
        ;;
    *)
        # In-process (not exec) so the nudge cache refreshes after any
        # passthrough command; read-only commands just cost one throttled
        # background job. set -e preserves git's exit code on failure.
        df_git "$@"
        refresh_sync_status_bg
        ;;
esac
