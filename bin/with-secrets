#!/usr/bin/env sh
# with-secrets — run a command with a named env preset injected.
#
#   with-secrets [--gated] <preset> [--] <command> [args...]
#   with-secrets grant [hours]
#   with-secrets revoke [preset]
#   with-secrets status
#
# Looks up <preset>.env and execs <command> with that preset's variables in its
# environment, resolving any op:// references via 1Password along the way.
#
# Preset lookup (work-specific overrides reusable):
#   1. ~/.local/config/shell/env.d/<preset>.env   (work / Stone Ridge, untracked)
#   2. ~/.config/shell/env.d/<preset>.env         (reusable / personal, tracked)
#
# This is the spawn-time companion to the `env <preset>` shell function in
# functions.d/env.sh, which sources the *same* files into your current shell.
# One preset file, two verbs:  `env` sources it;  `with-secrets` runs a child
# with it. The bin form exists because MCP hosts (and cron, etc.) spawn a
# command on PATH and cannot call a shell function.
#
# Gated mode: pass `--gated` as the first argument to make an MCP entry stay
# dormant on first spawn and connect on respawn — zero typed commands, same
# UX as an OAuth reconnect. In gated mode, no `op run` (and so no 1Password
# prompt) happens unless, in order:
#   1. a fresh keychain cache exists for this preset (see below): export the
#      cached vars and exec directly, no op involvement at all.
#   2. or a grant is active (headless override):
#        with-secrets grant [hours]   — open a grant, default 8 hours
#        with-secrets revoke [preset] — with preset, clear its cache only;
#                                       bare, close the grant AND every
#                                       known preset's cache
#        with-secrets status          — grant + backend + per-preset cache
#   3. or a respawn marker already exists for this (parent process instance,
#      preset): Claude Code spawns each stdio server at most once per
#      session, so any second spawn is a human doing /mcp reconnect. This is
#      the CONNECT path: resolve the preset with ONE op process, stash the
#      result to the keychain (best-effort, TTL-bounded), then exec directly.
#      The marker itself is never deleted here, so a cancelled Touch ID
#      stays retryable by reconnecting again.
#   4. else -> create the marker, prune stale ones, refuse.
# The grant is a single expiry epoch in a state file (not a secret). Any
# keychain-cache anomaly (no backend, decode failure, bad/expired expiry,
# partial data) is always treated as a miss that falls through to step 2:
# never exec with a partial/garbage environment. Ungated invocations (the
# default, used by cron and one-off runs) never touch any of this: byte-
# identical to before gated mode existed.
#
# Keychain cache backend: macOS `security` only for now (detection isolated
# in have_backend so a libsecret branch can be added later without touching
# call sites). Absent backend = silently skip cache read/stash, v2-only
# behavior everywhere else. TTL default 8h, override via
# WITH_SECRETS_CACHE_HOURS at connect time; expiry is script-enforced, since
# the keychain itself has no native TTL.
#
# Backend is 1Password (`op run`) for now. To switch managers, change the one
# exec line below (e.g. `doppler run --`, `bws run --`, `sops exec-env`).
set -eu

prog=$(basename "$0")
grant_file="${XDG_CACHE_HOME:-$HOME/.cache}/with-secrets/grant"

# --- keychain cache: detection, read (destructive on anomaly), peek
# (read-only, for status), delete, and preset var-name parsing. ---

have_backend() {
	command -v security >/dev/null 2>&1
}

cache_delete() {
	have_backend || return 0
	security delete-generic-password -a "$USER" -s "with-secrets/$1" >/dev/null 2>&1 || true
}

# Read-only: never deletes, just reports "fresh <date>" / "expired" / "none"
# for `status`. A malformed payload we can't parse an expiry from is "none"
# rather than a guess.
cache_peek() {
	have_backend || { echo "none"; return 0; }
	blob=$(security find-generic-password -a "$USER" -s "with-secrets/$1" -w 2>/dev/null) || { echo "none"; return 0; }
	[ -n "$blob" ] || { echo "none"; return 0; }
	payload=$(printf '%s' "$blob" | base64 -D 2>/dev/null) || payload=""
	[ -n "$payload" ] || { echo "none"; return 0; }
	expiry=$(printf '%s\n' "$payload" | sed -n '1p')
	case "$expiry" in
	''|*[!0-9]*)
		echo "none"
		return 0
		;;
	esac
	now=$(date +%s)
	if [ "$now" -ge "$expiry" ]; then
		echo "expired"
	else
		echo "fresh $(date -r "$expiry")"
	fi
}

# Prints resolved VAR=VALUE lines on stdout for a fresh, well-formed cache
# hit and returns 0; on ANY anomaly (no backend, no item, bad base64, bad or
# expired expiry, no data lines, a data line that isn't NAME=VALUE-shaped),
# deletes the item if one was actually found and returns 1. Never lets a
# partial or garbage payload through.
cache_read() {
	have_backend || return 1
	blob=$(security find-generic-password -a "$USER" -s "with-secrets/$1" -w 2>/dev/null) || return 1
	[ -n "$blob" ] || return 1
	payload=$(printf '%s' "$blob" | base64 -D 2>/dev/null) || payload=""
	if [ -z "$payload" ]; then
		cache_delete "$1"
		return 1
	fi
	expiry=$(printf '%s\n' "$payload" | sed -n '1p')
	case "$expiry" in
	''|*[!0-9]*)
		cache_delete "$1"
		return 1
		;;
	esac
	now=$(date +%s)
	if [ "$now" -ge "$expiry" ]; then
		cache_delete "$1"
		return 1
	fi
	data=$(printf '%s\n' "$payload" | sed '1d')
	if [ -z "$data" ]; then
		cache_delete "$1"
		return 1
	fi
	bad=0
	while IFS= read -r kv; do
		[ -n "$kv" ] || continue
		case "$kv" in
		[A-Za-z_]*=*) : ;;
		*) bad=1 ;;
		esac
	done <<-DATA
	$data
	DATA
	if [ "$bad" -eq 1 ]; then
		cache_delete "$1"
		return 1
	fi
	printf '%s\n' "$data"
	return 0
}

# Prints one declared var name per line, parsed from `export NAME=...`
# lines in the given preset file. Comments and blank lines are ignored.
preset_var_names() {
	sed -n 's/^[[:space:]]*export[[:space:]]\{1,\}\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$1"
}

# CONNECT path: called only when a respawn marker already exists (a human is
# reconnecting via /mcp). Resolves the current $preset with ONE op process,
# stashes the result to the keychain best-effort (TTL-bounded), exports the
# resolved vars, and execs this function's own args (the original command).
connect() {
	env_file=""
	for d in "$HOME/.local/config/shell/env.d" "$HOME/.config/shell/env.d"; do
		if [ -f "$d/$preset.env" ]; then
			env_file="$d/$preset.env"
			break
		fi
	done
	if [ -z "$env_file" ]; then
		echo "$prog: no env preset '$preset'" >&2
		echo "  looked in: $HOME/.local/config/shell/env.d/$preset.env" >&2
		echo "             $HOME/.config/shell/env.d/$preset.env" >&2
		exit 1
	fi

	# One op process = one authorization = one Touch ID for this session.
	op_out=$(op run --no-masking --env-file="$env_file" -- /usr/bin/env) && op_rc=0 || op_rc=$?
	if [ "$op_rc" -ne 0 ]; then
		exit "$op_rc"
	fi

	declared=$(preset_var_names "$env_file")
	resolved=""
	while IFS= read -r name; do
		[ -n "$name" ] || continue
		line=$(printf '%s\n' "$op_out" | grep -m1 "^$name=") || line=""
		[ -n "$line" ] || continue
		if [ -z "$resolved" ]; then
			resolved="$line"
		else
			resolved="$resolved
$line"
		fi
	done <<-DECL
	$declared
	DECL

	if [ -z "$resolved" ]; then
		echo "$prog: op resolved no declared vars for preset '$preset'" >&2
		exit 1
	fi

	if have_backend; then
		ttl_hours=${WITH_SECRETS_CACHE_HOURS:-8}
		cache_expiry=$(($(date +%s) + ttl_hours * 3600))
		payload=$(printf '%s\n%s\n' "$cache_expiry" "$resolved")
		payload_b64=$(printf '%s' "$payload" | base64 -b 0)
		if security add-generic-password -a "$USER" -s "with-secrets/$preset" -w "$payload_b64" -U -T /usr/bin/security >/dev/null 2>&1; then
			echo "with-secrets: cached '$preset' credentials for ${ttl_hours}h" >&2
		else
			echo "with-secrets: keychain stash failed for '$preset' (continuing without cache)" >&2
		fi
	fi

	while IFS= read -r kv; do
		[ -n "$kv" ] || continue
		export "$kv"
	done <<-RESOLVED
	$resolved
	RESOLVED

	exec "$@"
}

case "${1:-}" in
grant)
	hours=${2:-8}
	expiry=$(($(date +%s) + hours * 3600))
	mkdir -p "$(dirname "$grant_file")"
	echo "$expiry" >"$grant_file"
	echo "$prog: grant active until $(date -r "$expiry")"
	exit 0
	;;
revoke)
	target=${2:-}
	if [ -n "$target" ]; then
		cache_delete "$target"
		echo "$prog: cache cleared for '$target'"
	else
		rm -f "$grant_file"
		for d in "$HOME/.local/config/shell/env.d" "$HOME/.config/shell/env.d"; do
			[ -d "$d" ] || continue
			for f in "$d"/*.env; do
				[ -f "$f" ] || continue
				cache_delete "$(basename "$f" .env)"
			done
		done
		echo "$prog: grant revoked"
	fi
	exit 0
	;;
status)
	if have_backend; then
		echo "$prog: keychain backend available"
	else
		echo "$prog: no keychain backend (dormant/reconnect behavior only)"
	fi
	expiry=$(cat "$grant_file" 2>/dev/null) || expiry=""
	case "$expiry" in ''|*[!0-9]*) expiry="" ;; esac
	now=$(date +%s)
	if [ -n "$expiry" ] && [ "$now" -lt "$expiry" ]; then
		echo "$prog: grant active until $(date -r "$expiry")"
	else
		echo "$prog: no active grant"
	fi
	seen_names=""
	for d in "$HOME/.local/config/shell/env.d" "$HOME/.config/shell/env.d"; do
		[ -d "$d" ] || continue
		for f in "$d"/*.env; do
			[ -f "$f" ] || continue
			name=$(basename "$f" .env)
			case " $seen_names " in
			*" $name "*) continue ;;
			esac
			seen_names="$seen_names $name"
			state=$(cache_peek "$name")
			echo "$prog: cache for '$name' $state"
		done
	done
	exit 0
	;;
esac

gated=0
if [ "${1:-}" = "--gated" ]; then
	gated=1
	shift
fi

if [ "$#" -lt 2 ]; then
	echo "usage: $prog [--gated] <preset> [--] <command> [args...]" >&2
	exit 64
fi

preset=$1
shift
[ "${1:-}" = "--" ] && shift
if [ "$#" -lt 1 ]; then
	echo "$prog: no command given for preset '$preset'" >&2
	exit 64
fi

if [ "$gated" -eq 1 ]; then
	cached=$(cache_read "$preset") && cache_hit=1 || cache_hit=0
	if [ "$cache_hit" -eq 1 ] && [ -n "$cached" ]; then
		# Fresh keychain cache: export resolved vars and exec directly. No
		# op involvement, no prompt, no marker/grant lookup at all.
		while IFS= read -r kv; do
			[ -n "$kv" ] || continue
			export "$kv"
		done <<-CACHED
		$cached
		CACHED
		exec "$@"
	fi

	expiry=$(cat "$grant_file" 2>/dev/null) || expiry=""
	case "$expiry" in ''|*[!0-9]*) expiry="" ;; esac
	now=$(date +%s)
	if [ -z "$expiry" ] || [ "$now" -ge "$expiry" ]; then
		# No active grant: fall back to the respawn-marker check. The key is
		# PPID plus the parent's start time, so PID reuse cannot alias a new
		# session onto an old marker. Any failure to evaluate the key or to
		# create the seen/ dir fails CLOSED: never proceed on an unevaluable
		# key.
		seen_dir="${XDG_CACHE_HOME:-$HOME/.cache}/with-secrets/seen"
		lstart=$(ps -p "$PPID" -o lstart= 2>/dev/null) || lstart=""
		key=""
		if [ -n "$lstart" ]; then
			key=$(printf '%s %s' "$PPID" "$lstart" | cksum | cut -d ' ' -f1) || key=""
		fi
		marker=""
		if [ -n "$key" ] && mkdir -p "$seen_dir" 2>/dev/null; then
			marker="$seen_dir/$key.$preset"
		fi
		if [ -n "$marker" ] && [ -f "$marker" ]; then
			# Human is reconnecting via /mcp: resolve + stash + exec
			# directly. connect() always exits (either it execs, replacing
			# this process, or it exits nonzero on failure).
			connect "$@"
		fi
		# First spawn attempt for this parent+preset (or an unevaluable
		# key/dir, which fails closed the same way here): mark it, prune
		# markers older than 7 days, and refuse. The marker is never
		# deleted on the refusal path itself.
		if [ -n "$marker" ]; then
			: >"$marker"
		fi
		find "$seen_dir" -type f -mtime +7 -delete 2>/dev/null || true
		echo "with-secrets: preset '$preset' is gated (dormant this session); reconnect via /mcp to connect, or run 'with-secrets grant [hours]'" >&2
		exit 1
	fi
fi

env_file=""
for d in "$HOME/.local/config/shell/env.d" "$HOME/.config/shell/env.d"; do
	if [ -f "$d/$preset.env" ]; then
		env_file="$d/$preset.env"
		break
	fi
done
if [ -z "$env_file" ]; then
	echo "$prog: no env preset '$preset'" >&2
	echo "  looked in: $HOME/.local/config/shell/env.d/$preset.env" >&2
	echo "             $HOME/.config/shell/env.d/$preset.env" >&2
	exit 1
fi

exec op run --no-masking --env-file="$env_file" -- "$@"
