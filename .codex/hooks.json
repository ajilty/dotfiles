{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "h=\"$(command -v moshi-hook 2>/dev/null)\"; [ -n \"$h\" ] && \"$h\" codex-hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/var/home/ajilty/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "awk 'NR==1\u0026\u0026/^---$/{f=1;next} f\u0026\u0026/^---$/{f=0;next} !f' '/var/home/ajilty/.agents/style.md'",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "h=\"$(command -v moshi-hook 2>/dev/null)\"; [ -n \"$h\" ] && \"$h\" codex-hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "h=\"$(command -v moshi-hook 2>/dev/null)\"; [ -n \"$h\" ] && \"$h\" codex-hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "h=\"$(command -v moshi-hook 2>/dev/null)\"; [ -n \"$h\" ] && \"$h\" codex-hook || true",
            "type": "command"
          }
        ]
      }
    ]
  }
}
