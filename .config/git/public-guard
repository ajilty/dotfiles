#!/usr/bin/env bash
# public-guard: the push-time private-string guard for public ajilty repos.
#
# Runs as a git pre-push hook: from global git config for every repo (git 2.54
# or later, see ~/.config/git/config), and from the dotfiles repo's own
# pre-push on any git. When the push goes to a GitHub repo owned by ajilty
# that GitHub says is public, it checks every commit this clone does not know
# to be public already. Known public: on a remote-tracking ref of a remote that
# fetches only from the destination, or only from the GitHub repo it was forked
# from. Everything else, including commits fetched from any other remote, is
# checked:
#   - no blocklist pattern in its added lines (binary files as text), the
#     names of files it adds, renames or changes, its author, committer or
#     message, nor in an annotated tag being pushed;
#   - author, committer and tagger are the expected identity (GitHub may
#     commit, as it does for merges on the web).
# Coverage follows GitHub: a repo is checked from the moment it is public and
# needs no setup. When GitHub cannot be asked, the repo is checked as public.
# Anything that cannot be checked blocks the push.
#
# usage: public-guard push [--public] <remote> <url>   (ref lines on stdin)
#   --public  the caller knows the repo is public: skip the GitHub lookup.
set -euo pipefail

EXPECTED="ajilty <github@ajilty.com>"
# GitHub commits as itself when merging or editing on the web; that identity
# reveals nothing, so it is accepted as a committer (never as an author).
GITHUB_COMMITTER="GitHub <noreply@github.com>"
OWNER="ajilty"
BLOCKLIST_FILE="$HOME/.local/config/dotfiles/blocklist"
ZERO=0000000000000000000000000000000000000000
MARK="@@public-guard-commit@@"
LOOKUP_SECONDS="${PUBLIC_GUARD_LOOKUP_SECONDS:-15}"

usage() { echo "usage: public-guard push [--public] <remote> <url>" >&2; exit 2; }
[[ "${1:-}" == push ]] || usage
shift
force_public=0
if [[ "${1:-}" == --public ]]; then force_public=1; shift; fi
remote="${1:-}"
push_url="${2:-}"

# repo_of <url> -> "owner/repo", lowercased, when the URL names a repo on
# GitHub; nothing otherwise. Takes https, ssh:// (port 443 via ssh.github.com
# too), git:// and scp-style (user@host:owner/repo) forms, any user or port,
# `www.`, a trailing `.git` or slash, and an ssh host alias whose HostName is
# GitHub.
repo_of() {
    local u auth host path
    u=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$u" in
        *://*)
            u="${u#*://}"
            auth="${u%%/*}"
            path="${u#"$auth"}"
            auth="${auth##*@}"
            host="${auth%%:*}"
            ;;
        *:*)
            # scp-style only when the colon comes before any slash
            auth="${u%%:*}"
            [[ "$auth" == */* ]] && return 0
            host="${auth##*@}"
            path="${u#*:}"
            ;;
        *) return 0 ;;
    esac
    host="${host#www.}"
    if [[ "$host" != github.com && "$host" != ssh.github.com && -n "$host" ]] \
        && command -v ssh >/dev/null 2>&1; then
        # Reads ssh config only; never connects.
        host=$(ssh -G "$host" 2>/dev/null | awk '$1 == "hostname" { print $2; exit }' | tr '[:upper:]' '[:lower:]') || host=""
        host="${host#www.}"
    fi
    [[ "$host" == github.com || "$host" == ssh.github.com ]] || return 0
    path="${path#/}"
    path="${path%/}"
    path="${path%.git}"
    [[ "$path" == */* && "$path" != */*/* ]] || return 0
    printf '%s\n' "$path"
}

# fetch_urls_of <remote> -> the URLs the remote fetches from (url, before and
# after insteadOf rewriting). push_urls_of adds where it pushes to.
fetch_urls_of() {
    git config --get-all "remote.$1.url" 2>/dev/null || true
    git ls-remote --get-url "$1" 2>/dev/null || true
}
push_urls_of() {
    fetch_urls_of "$1"
    git config --get-all "remote.$1.pushurl" 2>/dev/null || true
}

# with_timeout <seconds> <command...>: a GitHub lookup must not hang a push.
# The command runs as a child in its own process group, and the whole group is
# sent TERM when time is up: gh, a Go program, ignores the SIGALRM an
# exec-in-place alarm would rely on, and anything it started would otherwise
# hold the output open.
with_timeout() {
    local s="$1"; shift
    if command -v perl >/dev/null 2>&1; then
        perl -e '$t = shift; $p = fork; exit 127 unless defined $p;
                 if (!$p) { setpgrp(0, 0); exec @ARGV or exit 127 }
                 $SIG{ALRM} = sub { kill "TERM", -$p; waitpid $p, 0; exit 124 };
                 alarm $t; waitpid $p, 0; exit($? >> 8)' "$s" "$@"
    else
        "$@"
    fi
}

# Which ajilty repos is this push going to?
targets=()
add_target() {
    local t
    for t in ${targets[@]+"${targets[@]}"}; do [[ "$t" == "$1" ]] && return 0; done
    targets+=("$1")
}
while IFS= read -r u; do
    [[ -z "$u" ]] && continue
    r=$(repo_of "$u")
    [[ "$r" == "$OWNER"/* ]] && add_target "$r"
done < <(printf '%s\n' "$push_url"; [[ -n "$remote" ]] && push_urls_of "$remote")

if (( ! force_public )) && (( ${#targets[@]} == 0 )); then
    exit 0  # not an ajilty repo on GitHub
fi

# Ask GitHub about each target, as the ajilty account when gh has it (another
# active account would see ajilty's private repos as missing). Public, or
# unknown, means checked. The answer also names the repo it was forked from.
public=$force_public
known=1
parents=()
gh_token=""
if (( ! force_public )) && command -v gh >/dev/null 2>&1; then
    gh_token=$(with_timeout "$LOOKUP_SECONDS" gh auth token --hostname github.com --user "$OWNER" 2>/dev/null) || gh_token=""
fi
for t in ${targets[@]+"${targets[@]}"}; do
    (( force_public )) && break
    answer=""
    if command -v gh >/dev/null 2>&1; then
        answer=$(GH_TOKEN="${gh_token:-${GH_TOKEN:-}}" GH_PROMPT_DISABLED=1 with_timeout "$LOOKUP_SECONDS" \
            gh api --hostname github.com "repos/$t" \
            --jq '[.visibility, (.parent.full_name // ""), (.source.full_name // "")] | join(" ")' \
            2>/dev/null) || answer=""
    fi
    vis="" p1="" p2=""
    read -r vis p1 p2 <<<"$answer" || true
    case "$vis" in
        private|internal) ;;
        public)
            public=1
            [[ -n "$p1" ]] && parents+=("$(printf '%s' "$p1" | tr '[:upper:]' '[:lower:]')")
            [[ -n "$p2" ]] && parents+=("$(printf '%s' "$p2" | tr '[:upper:]' '[:lower:]')")
            ;;
        *)
            public=1
            known=0
            echo "public-guard: could not ask GitHub whether $t is public; checking it as public." >&2
            ;;
    esac
done
(( public )) || exit 0

label="${targets[0]:-this repo}"
if (( known )); then where_text="$label is public on GitHub"; else where_text="$label may be public on GitHub"; fi

# ---------------------------------------------------------------------------
# The blocklist. Missing, unreadable or empty blocks: this is a public repo.
# ---------------------------------------------------------------------------
if [[ ! -r "$BLOCKLIST_FILE" ]]; then
    echo "ERROR: public-guard: no readable blocklist at $BLOCKLIST_FILE." >&2
    echo "  Push blocked: $where_text and cannot be checked without it." >&2
    echo "  Run \`dotfiles blocklist sync\`, then push again." >&2
    exit 1
fi
patterns=()
# `|| [[ -n "$line" ]]` keeps a last line that has no trailing newline.
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    patterns+=("${line%$'\r'}")
done < "$BLOCKLIST_FILE"
if (( ${#patterns[@]} == 0 )); then
    echo "ERROR: public-guard: the blocklist at $BLOCKLIST_FILE has no patterns." >&2
    echo "  Push blocked: $where_text. Run \`dotfiles blocklist sync\`, then push again." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Known public: remote-tracking refs of a remote whose every fetch URL is the
# destination or the repo it was forked from. A remote that fetches from
# anywhere else (a private or work repo) proves nothing, whatever it pushes to.
# ---------------------------------------------------------------------------
trusted_repo() {  # trusted_repo <owner/repo>
    local x
    for x in ${targets[@]+"${targets[@]}"} ${parents[@]+"${parents[@]}"}; do
        [[ "$1" == "$x" ]] && return 0
    done
    return 1
}
public_refs=()
while IFS= read -r r; do
    [[ -z "$r" ]] && continue
    ok=0
    while IFS= read -r u; do
        [[ -z "$u" ]] && continue
        ru=$(repo_of "$u")
        if [[ -n "$ru" ]] && trusted_repo "$ru"; then ok=1; else ok=0; break; fi
    done < <(fetch_urls_of "$r")
    (( ok )) && public_refs+=("--remotes=$r")
done < <(git remote)
# --public (the dotfiles repo) names no target: trust the remote being pushed
# to, when it is a configured remote, as before.
if (( force_public && ${#targets[@]} == 0 )) && [[ -n "$remote" ]] \
    && git config --get "remote.$remote.url" >/dev/null 2>&1; then
    public_refs+=("--remotes=$remote")
fi

text=$(mktemp)
attr=$(mktemp)
trap 'rm -f "$text" "$attr" "$text.part" "$attr.part"' EXIT
trap '' XFSZ  # a file-size limit becomes a write error, so the cleanup runs

# Render git output into the text to scan, as plain lines (for the verdict)
# and as "<commit><TAB>line" (to name the commits). Input is commit blocks:
# "$MARK <commit>", author, committer, the message, "$MARK-end", then the
# diff; or "$MARK <commit>" followed by file names. Messages are also folded
# onto one line, so a string wrapped across lines still matches. Only added
# lines of a diff are kept: removing a private string must never block.
# NUL bytes in binary content become spaces first: awk would cut a line there.
render='
BEGIN { state = "none" }
function out(s) { print s > T; print sha "\t" s > A }
function flush() { if (folded != "") out(folded); folded = "" }
index($0, M " ") == 1 { flush(); sha = substr($0, length(M) + 2); state = "meta"; next }
$0 == M "-end" { flush(); state = "body"; next }
state == "meta" { out($0); folded = (folded == "" ? $0 : folded " " $0); next }
state == "names" { if ($0 != "") out($0); next }
/^diff --git / { state = "hdr"; next }
state != "none" && /^@@ / { state = "hunk"; next }
state == "hunk" && /^\+/ { out(substr($0, 2)); next }
END { flush() }
'
names_render='
index($0, M " ") == 1 { sha = substr($0, length(M) + 2); next }
$0 != "" { print > T; print sha "\t" $0 > A }
'
append() {  # append <command...>: run, render into the .part files, add them
    rm -f "$text.part" "$attr.part"
    "$@" || return 1
    if [[ -f "$text.part" ]]; then
        cat "$text.part" >> "$text" && cat "$attr.part" >> "$attr" || return 1
    fi
    rm -f "$text.part" "$attr.part"
}
commits_text() {  # commits_text <range...>
    git -c log.showRoot=true -c core.quotePath=false log --no-color --no-ext-diff --no-textconv \
        --text --no-renames -p -U0 --diff-merges=remerge \
        --format="$MARK %h%n%an <%ae>%n%cn <%ce>%n%B%n$MARK-end" "$@" \
        | LC_ALL=C tr '\000' ' ' \
        | LC_ALL=C awk -v T="$text.part" -v A="$attr.part" -v M="$MARK" "$render"
}
names_text() {  # names_text <range...>: names of files added, renamed or changed
    git -c core.quotePath=false log --no-renames --name-only --diff-filter=ACMRT \
        --diff-merges=remerge --format="$MARK %h" "$@" \
        | LC_ALL=C awk -v T="$text.part" -v A="$attr.part" -v M="$MARK" "$names_render"
}
tag_text() {  # tag_text <ref> <tag object>
    { printf '%s %s\n' "$MARK" "$1"; git cat-file tag "$2"; printf '%s-end\n' "$MARK"; } \
        | LC_ALL=C awk -v T="$text.part" -v A="$attr.part" -v M="$MARK" "$render"
}

fail=0
other_authors=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_ref:-}" ]] && continue
    [[ "$local_sha" == "$ZERO" ]] && continue  # a delete sends nothing
    range=("$local_sha" --not)
    [[ "$remote_sha" != "$ZERO" ]] && range+=("$remote_sha")
    range+=(${public_refs[@]+"${public_refs[@]}"})

    # List the commits first; a failed listing (a force-push over a remote
    # tip this clone has never fetched) must block, not read as "nothing".
    if ! idents=$(git log --format='%h%x09%an <%ae>%x09%cn <%ce>' "${range[@]}"); then
        echo "ERROR: could not list the commits going to $remote_ref. Most likely the" >&2
        echo "  remote has commits this clone lacks: if so, fetch $remote_ref from" >&2
        echo "  ${remote:-the remote} and push again." >&2
        fail=1
        continue
    fi
    # A merge of three or more branches shows no diff of its own to scan
    # (git skips octopus merges in --diff-merges=remerge), so it cannot be
    # checked: block it and ask for ordinary two-parent merges instead.
    if ! octopus=$(git log --min-parents=3 --format=%h "${range[@]}"); then
        echo "ERROR: public-guard could not read the commits going to $remote_ref." >&2
        exit 1
    fi
    for short in $octopus; do
        echo "ERROR: $short on $remote_ref merges three or more branches at once, which" >&2
        echo "  public-guard cannot check. Merge them one at a time instead." >&2
        fail=1
    done
    while IFS=$'\t' read -r short who_a who_c; do
        [[ -z "$short" ]] && continue
        if [[ "$who_a" != "$EXPECTED" || ( "$who_c" != "$EXPECTED" && "$who_c" != "$GITHUB_COMMITTER" ) ]]; then
            echo "ERROR: $short on $remote_ref: author '$who_a', committer '$who_c'; expected '$EXPECTED'." >&2
            fail=1
            other_authors=1
        fi
    done <<<"$idents"

    if [[ "$(git cat-file -t "$local_sha" 2>/dev/null)" == tag ]]; then
        tagger=$(git cat-file tag "$local_sha" | sed -n 's/^tagger \(.*>\) [0-9]* [-+][0-9]*$/\1/p')
        if [[ "$tagger" != "$EXPECTED" ]]; then
            echo "ERROR: tag $local_ref: tagger '$tagger'; expected '$EXPECTED'." >&2
            fail=1
        fi
        append tag_text "$local_ref" "$local_sha" || {
            echo "ERROR: public-guard could not read tag $local_ref." >&2
            exit 1
        }
    fi
    if ! append commits_text "${range[@]}" || ! append names_text "${range[@]}"; then
        echo "ERROR: public-guard could not read the commits going to $remote_ref." >&2
        exit 1
    fi
done

# Each pattern greps a file holding the text, never a pipe or a here-string:
# grep's own status is the only one left. 0 is a hit, 1 is "ran and found
# nothing", anything else blocks.
for p in "${patterns[@]}"; do
    rc=0
    if [[ "$p" == re:* ]]; then
        grep -qiE -- "${p#re:}" "$text" || rc=$?
    else
        grep -qiF -- "$p" "$text" || rc=$?
    fi
    case $rc in
        0)
            fail=1
            where=$( { if [[ "$p" == re:* ]]; then grep -iE -- "${p#re:}" "$attr"; else grep -iF -- "$p" "$attr"; fi; } \
                | cut -f1 | awk '!seen[$0]++' | head -5 | paste -sd ' ' - ) || where=""
            printf 'ERROR: %s matches blocklist pattern: %s\n' "${where:-a commit in this push}" "$p" >&2
            ;;
        1) ;;
        *)
            printf 'ERROR: blocklist pattern failed to run: %s\n' "$p" >&2
            echo "Push blocked: public-guard could not check this push. Fix the pattern in the" >&2
            echo "blocklist gist, then run \`dotfiles blocklist sync\`." >&2
            exit 1
            ;;
    esac
done

if (( fail )); then
    echo "" >&2
    echo "Push blocked by public-guard: $where_text. Fix what is named above" >&2
    echo "before pushing." >&2
    if (( other_authors )); then
        echo "  Another author's commit passes only when it is already on the destination," >&2
        echo "  or on a remote that fetches from the repo this one was forked from: for a" >&2
        echo "  fork sync, add that remote and fetch it, or use GitHub's Sync fork. To fix" >&2
        echo "  your own commits: \`git rebase --exec 'git commit --amend --no-edit" >&2
        echo "  --reset-author' <base>\` (in the dotfiles repo, see the dotfiles skill)." >&2
    fi
    exit 1
fi
