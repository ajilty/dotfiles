# Evernote cleanup home base: Claude Code via OpenRouter with Zero Data
# Retention. The Evernote MCP is OAuth (remote server); nothing for it here.
#
#   Launch:  with-secrets evernote-exit -- claude
#   Shell:   env evernote-exit
#
# Values are 1Password references, resolved at runtime; no secret lands here.
# The OpenRouter key AND the base URL live here (not in the project's
# settings.json) because Claude Code must see the gateway credential before
# its first-run trust prompt, and project settings only apply after it.

# OpenRouter: a dedicated key with the Zero-Data-Retention guardrail on.
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="op://Private/OpenRouter evernote-exit/credential"
export ANTHROPIC_API_KEY=""
